# Required. Keep this secret and configure it server-side only.
LASTFM_API_KEY=your_lastfm_api_key

# Optional local convenience. Public/plugin deployments should usually leave this blank
# so every tool call specifies the relevant Last.fm username.
LASTFM_USERNAME=WJMonde

LASTFM_USER_AGENT=lastfm-mcp/0.3.0
LASTFM_CACHE_TTL_SECONDS=300
PORT=3000

# Keep 127.0.0.1 for local use. Most cloud/container hosts need 0.0.0.0.
HOST=127.0.0.1
