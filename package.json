{
  "name": "lastfm-mcp",
  "version": "0.3.0",
  "description": "Small read-only MCP server for Last.fm listening history",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "test": "tsx src/__tests__/rediscovery.test.ts && tsx src/__tests__/user-resolver.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.5",
    "@modelcontextprotocol/node": "^2.0.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0"
  }
}
